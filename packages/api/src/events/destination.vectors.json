      "title": "Morning summary · 2026-10-16",
      "reason": "policy_new"
    }
  },
  {
    "name": "policy subject with a natural subject keys and titles by it",
    "input": {
      "rule": { "id": "rule-9", "kind": "subscription", "name": "PR reviews grouped", "policy": { "mode": "subject" } },
      "event": {
