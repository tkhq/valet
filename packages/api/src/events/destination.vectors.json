    "input": {
      "rule": { "id": "rule-10", "kind": "subscription", "name": "Channel watch", "policy": { "mode": "subject" } },
      "event": { "deliveryId": "del-10", "summary": "Team joined", "naturalSubject": null, "conversational": false },
