{
  "name": "@valet/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./src/main.ts"
    },
    "./wire": {
      "types": "./src/wire/types.ts",
      "import": "./src/wire/types.ts"
    },
    "./memory-links": {
      "types": "./src/lib/memory-links.ts",
      "import": "./src/lib/memory-links.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build:assets": "node build/copy-assets.mjs",
    "build:bundle": "node build.mjs",
    "build": "pnpm run build:assets && pnpm run build:bundle",
    "build:tar": "node build/make-assets-tar.mjs",
    "build:binary": "pnpm run build:assets && pnpm run build:bundle && pnpm run build:tar && node build/compile-binary.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "smoke:session": "tsx scripts/smoke-session.ts",
    "smoke:orchestrator": "tsx scripts/smoke-orchestrator.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.23",
    "@better-auth/sso": "1.6.23",
    "@electric-sql/pglite": "^0.5.0",
    "@hono/node-server": "^1.13.0",
    "@hono/node-ws": "^1.0.0",
    "@kubernetes/client-node": "^1.4.0",
    "@mariozechner/pi-agent-core": "0.73.0",
    "@mariozechner/pi-ai": "0.73.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@valet/engine": "workspace:*",
    "@valet/plugin-browser": "workspace:*",
    "@valet/plugin-cloudflare": "workspace:*",
    "@valet/plugin-deepwiki": "workspace:*",
    "@valet/plugin-github": "workspace:*",
    "@valet/plugin-gmail": "workspace:*",
    "@valet/plugin-google-calendar": "workspace:*",
    "@valet/plugin-google-workspace": "workspace:*",
    "@valet/plugin-linear": "workspace:*",
    "@valet/plugin-notion": "workspace:*",
    "@valet/plugin-openai": "workspace:*",
    "@valet/plugin-personas": "workspace:*",
    "@valet/plugin-sandbox-tunnels": "workspace:*",
    "@valet/plugin-sentry": "workspace:*",
    "@valet/plugin-slack": "workspace:*",
    "@valet/plugin-stripe": "workspace:*",
    "@valet/plugin-telegram": "workspace:*",
    "@valet/plugin-typefully": "workspace:*",
    "@valet/plugin-workflows": "workspace:*",
    "@valet/sandbox-docker": "workspace:*",
    "@valet/sandbox-gateway": "workspace:*",
    "@valet/sandbox-kubernetes": "workspace:*",
    "@valet/sandbox-local": "workspace:*",
    "@valet/sdk": "workspace:*",
    "@valet/shared": "workspace:*",
    "@valet/store-postgres": "workspace:*",
    "@valet/workflow": "workspace:*",
    "better-auth": "1.6.23",
    "cron-parser": "^5.7.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.3.0",
    "pg": "^8.22.0",
    "tsx": "^4.0.0",
    "typebox": "^1.1.24",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
