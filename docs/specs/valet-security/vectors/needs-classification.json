[
  {
    "id": "classify-001",
    "level": "L2",
    "description": "Auto bucket: scope-auto-include with IP in CIDR (L2 not required to execute; classifies auto only at L3+)",
    "input": {
      "need": {
        "id": "n-dast-scope-staging",
        "kind": "scope-expansion",
        "proposed_resolution": {
          "auto": {
            "pattern": "scope-auto-include",
            "params": {"host": "staging.example.com", "discovered_ip": "10.1.2.3"}
          },
          "human": {"ask": "Approve scope expansion to staging.example.com"}
        }
      },
      "ctx": {
        "authorized_cidrs": ["10.0.0.0/8"],
        "loot": {"sessions": [], "credentials": [], "test_data": [], "tool_auth": []},
        "level": 2
      }
    },
    "expected": {"bucket": "human"}
  },
  {
    "id": "classify-002",
    "level": "L2",
    "description": "Human bucket: test-data need with no auto pattern",
    "input": {
      "need": {
        "id": "n-fuzz-payment-test-data",
        "kind": "test-data",
        "proposed_resolution": {
          "auto": {"pattern": "", "params": {}},
          "human": {"ask": "Provide a test credit card"}
        }
      },
      "ctx": {
        "authorized_cidrs": [],
        "loot": {"sessions": [], "credentials": [], "test_data": [], "tool_auth": []},
        "level": 2
      }
    },
    "expected": {"bucket": "human"}
  },
  {
    "id": "classify-003",
    "level": "L3",
