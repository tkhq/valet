      "need": {
        "id": "n-fuzz-session",
        "kind": "session",
        "proposed_resolution": {
          "auto": {"pattern": "propagate-session", "params": {"source_session_id": "s-human-1"}},
          "human": {"ask": "Provide admin credentials"}
        }
      },
      "ctx": {
        "authorized_cidrs": [],
        "loot": {
          "sessions": [{"id": "s-human-1", "host": "api.example.com", "cookie_jar": "loot/cookies-s-human-1.txt"}],
          "credentials": [], "test_data": [], "tool_auth": []
        },
        "level": 3
      }
    },
    "expected": {"bucket": "auto"}
  },
  {
    "id": "classify-004",
    "level": "L3",
    "description": "Human bucket: propagate-session with missing source session; params do not resolve",
    "input": {
      "need": {
        "id": "n-fuzz-session",
