    "expected": {"bucket": "human"}
  },
  {
    "id": "classify-005",
    "level": "L2",
    "description": "v1 human bucket (v2 deferred bucket); need with a blocked_by list, no auto pattern",
    "input": {
      "need": {
        "id": "n-fuzz-payment",
        "kind": "test-data",
        "blocked_by": ["n-fuzz-session"],
        "proposed_resolution": {
