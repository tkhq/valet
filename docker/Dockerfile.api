# syntax=docker/dockerfile:1.7
# Valet API image — @valet/api serving @valet/web (kubernetes-deployment
# design decision 3: one pod, one Service, no separate web deployment).
#
# Build with plain `docker build` (decision 2 — the reference environment
# runs Rancher Desktop in moby mode, where k3s uses cri-dockerd and
# docker-built images are directly visible to pods; do NOT use nerdctl here).
# From the repo root:
#
#   docker build -f docker/Dockerfile.api -t valet-api:dev .
#
# Iteration knob: pass `--build-arg SKIP_TYPECHECK=1` to skip the workspace
# `pnpm typecheck` step. Safe when you've already run `pnpm typecheck`
# locally against the same tree; shaves the largest chunk off the loop.
#
# Runtime notes:
#   - Node 22 + a slim Debian base is sufficient: sqlite (native
#     better-sqlite3) is retired from this stack — the api's stores are
#     PGlite (wasm) or `pg` (pure JS) — so no build toolchain is needed at
#     runtime, and none of @valet/api's dependency tree pulls in a
#     node-gyp-built native addon (verified: no `"gypfile": true` package in
#     the resolved tree).
#   - The api runs its TypeScript source directly via `tsx` (same as `pnpm
#     --filter @valet/api start` in dev) rather than a separate `tsc`
#     compile step — `tsx` is a runtime dependency of @valet/api for exactly
#     this reason.
#   - `pnpm deploy --prod` (pnpm's workspace-aware "produce one deployable
#     package dir" command) resolves every `workspace:*` dependency and
#     copies only production dependencies — the packages that ship
#     compiled `dist/` output (`@valet/shared`, `@valet/plugin-*`) must be
#     built BEFORE the deploy step runs, since deploy only copies what's
#     already on disk.

# ─── Stage 1: install + build ──────────────────────────────────────────
FROM node:22-bookworm-slim AS builder

# `prepare --activate` warms corepack's cache AND sets the default shim
# version — but inside this repo the `packageManager` pin in package.json
# still overrides it. Keep this equal to the pin, or the build silently
# runs a different pnpm than this line claims.
RUN corepack enable && corepack prepare pnpm@10.30.3 --activate

WORKDIR /repo

# Full monorepo source (root .dockerignore excludes node_modules, .git,
# workspace dist/coverage/tsbuildinfo). A single COPY keeps this simple;
# the win from splitting it into a lockfile-only layer isn't worth the
# workspace-glob complexity because the pnpm-store cache mount below makes
# `pnpm install` fast on every rebuild anyway.
COPY . .

# BuildKit cache mount for the pnpm content-addressed store — survives
# across builds even when the COPY layer above invalidates. First build:
# populates the store from the network. Subsequent builds: `pnpm install`
# resolves everything from the local cache in seconds. `sharing=locked`
# prevents concurrent builds from stomping the store.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store,sharing=locked \
    pnpm config set store-dir /pnpm-store && \
    pnpm install --frozen-lockfile

# Root `pnpm typecheck` is `tsc --build` over the project-reference graph:
# the only command that emits every workspace dist/ in dependency order
# (per-package plain `tsc` can't — it doesn't build referenced projects, so
# e.g. sdk fails against an unbuilt engine on a fresh checkout with no
# local build state).
#
# `SKIP_TYPECHECK=1` swaps the full `tsc --build` (typecheck + emit) for
# `tsc --build --noCheck` (emit only, no type checking). The reference-
# graph walk is unchanged so every workspace dist still lands in dep
# order; only per-file type checking is skipped. Safe when the invoking
# developer has already run `pnpm typecheck` locally against the same
# tree.
ARG SKIP_TYPECHECK=0
RUN if [ "$SKIP_TYPECHECK" = "1" ]; then \
      echo "SKIP_TYPECHECK=1 — emitting dists without type checking"; \
      pnpm exec tsc --build --noCheck; \
    else \
      pnpm typecheck; \
    fi

# The web SPA baked into this image (decision 3).
RUN pnpm --filter @valet/web run build

# Self-contained production-only deploy of @valet/api: resolves every
# workspace dependency to real files (not symlinks) and installs with
# --prod, so devDependencies (typescript, vitest, drizzle-kit, ...) are
# excluded from what ships. --legacy keeps the pnpm 9 deploy semantics
# under pnpm 10+ (without it, deploy hard-fails with
# ERR_PNPM_DEPLOY_NONINJECTED_WORKSPACE unless the whole workspace opts
# into inject-workspace-packages, which would change local-dev linking).
RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store,sharing=locked \
    pnpm --filter @valet/api deploy --legacy --prod /out/api

# ─── Stage 2: runtime ───────────────────────────────────────────────────
FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY --from=builder /out/api ./
COPY --from=builder /repo/packages/web/dist ./web/dist

# Gates `static-web.ts`'s SPA mount — unset in `make dev-local` (Vite dev
# server serves the web app there instead). See packages/api/src/main.ts.
ENV VALET_WEB_DIST_DIR=/app/web/dist
ENV PORT=8787
EXPOSE 8787

ENTRYPOINT ["node_modules/.bin/tsx", "src/cli.ts", "serve"]
