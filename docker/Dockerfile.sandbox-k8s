# CI-published full-profile base image for the `sandbox-kubernetes` provider
# (kubernetes-deployment design decision 2). This image is the FROM target for
# the auto-seeded `kind='base', profile='full'` image_sources row — it ships
# the compiled `@valet/sandbox-gateway` bundle, ttyd, and code-server on top
# of the headless agent tooling, making it suitable for interactive developer
# sessions. Published as `ghcr.io/tkhq/valet-sandbox:sha-<shortsha>` by
# `.github/workflows/docker-publish.yml`. NOT the legacy OpenCode/VNC/code-
# server dev-environment image at `docker/Dockerfile.sandbox` (that one backs
# the Modal/docker-compose "opencode" stack and is intentionally left
# untouched).
#
# `packages/sandbox-kubernetes/src/manifest.ts` sets the pod's `command`
# depending on profile:
#   - `headless` (default): a non-terminating tail (mirroring sandbox-
#     docker's default `node:20-bookworm` container) — agent-only, no
#     interactive services. `docker/start-full.sh` mirrors this branch when
#     `VALET_SANDBOX_PROFILE` is unset/`headless`, so the sandbox-docker
#     provider gets the same behavior from the same image/entrypoint.
#   - `full`: `["/bin/bash", "/start-full.sh"]` — starts ttyd, code-server,
#     and the auth gateway (sandbox auth gateway spec). See
#     `docker/start-full.sh`.
#
# What matters either way: a shell, coreutils (incl. base64, used for
# binary-safe file ops over `pods/exec` — see the design doc's "File ops
# ride exec" section), git, ripgrep, ca-certificates, Node, and the
# `agent-browser` CLI with its chromium (the engine's exec-based tool calls
# and the bundled `browser` skill assume these are on PATH) — plus, for
# `full` profile, ttyd + code-server + the bundled `@valet/sandbox-gateway`.
#
# Build with plain `docker build` (decision 2 — moby mode, not nerdctl):
#
#   docker build -f docker/Dockerfile.sandbox-k8s -t valet-sandbox:dev .
#
# Gateway bundling choice: `pnpm deploy --filter @valet/sandbox-gateway
# --prod` (same pattern as `docker/Dockerfile.api`'s api stage) rather than
# esbuild — the gateway's deps (hono, @hono/node-server, @hono/node-ws, ws)
# are plain CJS/ESM npm packages with no native addons, so a pruned,
# workspace-resolved `node_modules` is simpler than maintaining a bundler
# config, and it matches how the rest of this repo already ships
# `@valet/api`. The gateway package must be `tsc`-built (produces `dist/`)
# BEFORE `pnpm deploy` runs — deploy only copies what's already on disk.
#
# Local docker-backend testing: `make dev-local` defaults to the plain
# `node:20-bookworm` sandbox-docker image, which has none of this. To
# exercise the gateway/ttyd/code-server path against the docker backend,
# point `VALET_SANDBOX_IMAGE` at an image built from this Dockerfile with a
# `full`-profile session (see Task 5 for the api wiring that passes the
# image through). This Dockerfile's own CMD is a bare shell fallback — both
# providers always set `command`/entrypoint explicitly per profile.

# ─── Base agent tooling (shared by both profiles) ──────────────────────
FROM node:22-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ripgrep \
    ca-certificates \
    coreutils \
    curl \
    procps \
    bash \
    openssh-client \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /workspace
WORKDIR /workspace

# ─── Gateway build stage ────────────────────────────────────────────────
# Builds @valet/sandbox-gateway's dist/ and produces a self-contained,
# production-only package dir (workspace deps resolved to real files, no
# devDependencies) at /out/gateway.
FROM node:22-bookworm-slim AS gateway-build

# `prepare --activate` warms corepack's cache AND sets the default shim
# version — but inside this repo the `packageManager` pin in package.json
# still overrides it. Keep this equal to the pin, or the build silently
# runs a different pnpm than this line claims.
RUN corepack enable && corepack prepare pnpm@10.30.3 --activate

WORKDIR /repo

# Full monorepo source (root .dockerignore excludes node_modules, .git,
# legacy build artifacts) — same approach as docker/Dockerfile.api; not
# layer-cache-optimized for partial dependency changes, acceptable for a
# pre-1.0 local/CI image.
COPY . .

RUN pnpm install --frozen-lockfile

RUN pnpm --filter @valet/sandbox-gateway run build
# --legacy: pnpm 9 deploy semantics under pnpm 10+ (see Dockerfile.api).
RUN pnpm --filter @valet/sandbox-gateway deploy --legacy --prod /out/gateway

# ─── Final image ────────────────────────────────────────────────────────
FROM base

# Package-manager shims for the SHIPPED image, not just build stages.
# node:22 bundles corepack but leaves it disabled: without `corepack
# enable` there is no `pnpm`/`yarn` on PATH, so any workspace-prep bake
# whose repo carries a pnpm lockfile dies at `pnpm install` with exit 127
# ("pnpm: not found") — observed live in an in-cluster prebuild. The
# shims resolve the version from each repo's `packageManager` pin at
# first use; the prepare below pre-warms a default so pin-less repos and
# offline paths still work. COREPACK_ENABLE_DOWNLOAD_PROMPT=0 stops
# corepack's interactive download prompt from wedging non-interactive
# RUN steps and agent execs.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@10.30.3 --activate

# code-server (VS Code in browser) — lifted from docker/Dockerfile.sandbox.
# Pinned (bump this ARG to upgrade) rather than an unpinned `curl | sh`,
# which would silently pull in whatever the installer resolves as "latest"
# on every rebuild.
ARG CODE_SERVER_VERSION=4.128.0
RUN curl -fsSL https://code-server.dev/install.sh | sh -s -- --version "${CODE_SERVER_VERSION}"

# ttyd (web terminal) — lifted from docker/Dockerfile.sandbox. ttyd's release
# assets are per-arch static binaries; map buildx's TARGETARCH onto its
# naming so multi-arch CI builds (amd64 + arm64) both resolve.
ARG TARGETARCH
RUN case "${TARGETARCH:-amd64}" in \
      amd64) TTYD_ARCH=x86_64 ;; \
      arm64) TTYD_ARCH=aarch64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL -o /usr/local/bin/ttyd \
      "https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.${TTYD_ARCH}" \
    && chmod +x /usr/local/bin/ttyd

# GitHub CLI (GitHub/repo integration plan, Task 8) — the `valet-gh` wrapper
# (engine/git-credential-helper.ts) execs the real `gh` with a Valet-resolved
# GH_TOKEN. Pinned (bump this ARG to upgrade), same rationale as
# CODE_SERVER_VERSION above. Installed from the versioned GitHub Releases
# .deb, NOT GitHub's apt repo: the apt repo only carries the latest version,
# so an apt pin breaks the build the moment gh ships a release (this
# happened — CI failed with "Version '2.63.2' for 'gh' was not found").
# Release assets are immutable, and per-arch (.deb arch matches TARGETARCH).
ARG GH_VERSION=2.63.2
RUN curl -fsSL -o /tmp/gh.deb \
      "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${TARGETARCH:-amd64}.deb" \
    && dpkg -i /tmp/gh.deb \
    && rm /tmp/gh.deb \
    && gh --version

# Security scanners (valet-security design, §plugin-security "Sandbox
# image"): pinned, read-only, offline-capable — personas run them against
# the clone, and rule updates ride image rebuilds, not runtime downloads,
# so sandbox egress stays closed. gitleaks ships its default ruleset inside
# the binary. gitleaks ONLY: semgrep is a Python package and this image
# carries no Python runtime, so baking it would add a whole toolchain for
# one tool (spec implementation deviation; plan risk 6 pre-authorizes
# gitleaks-only). Release assets are per-arch tarballs with a published
# checksums.txt — the sha256 per arch is pinned below, so a GITLEAKS_VERSION
# bump must also update both hashes from the new checksums.txt.
ARG GITLEAKS_VERSION=8.30.1
RUN case "${TARGETARCH:-amd64}" in \
      amd64) GITLEAKS_ARCH=x64; \
             GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb ;; \
      arm64) GITLEAKS_ARCH=arm64; \
             GITLEAKS_SHA256=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL -o /tmp/gitleaks.tar.gz \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GITLEAKS_ARCH}.tar.gz" \
    && echo "${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
    && rm /tmp/gitleaks.tar.gz \
    && gitleaks version

# sec-preflight — the tool-presence probe the sast/secrets personas run before
# they record coverage (NOT_ASSESSED ledger, M-P2d). It prints a tool table:
# name, present(y/n), version, and the consequence that becomes NOT_ASSESSED
# when the tool is absent. gitleaks probes present here; semgrep and the
# language scanners probe absent (not baked — see the note above), so the
# persona records them as not_assessed with the printed consequence.
COPY docker/sec-preflight.sh /usr/local/bin/sec-preflight
RUN chmod +x /usr/local/bin/sec-preflight

# Live-testing tool bake (M-P4a proof). The declared-tool mechanism provisions a
# repo's tools per engagement; this bakes ONE lightweight live tool as proof the
# path reaches a real binary — `curl` (already installed above) plus a small fuzz
# wordlist the dast/fuzz personas point at. A heavier scanner (nuclei, ZAP) is
# provisioning DATA a repo declares in .valet/security.yml (a ToolDecl install/
# image/mcp), installed per repo, NOT baked for every session. The live personas
# read VALET_SECURITY_AUTHORIZED_SCOPE to bound their egress to the authorized
# scope (M-P4b) — sandbox egress otherwise stays closed, same posture as the
# static scanners above.
COPY docker/sec-fuzz-wordlist.txt /usr/local/share/valet/sec-fuzz-wordlist.txt

# Browser automation. The bundled `browser` plugin skill tells the agent it
# has `agent-browser`; without these two layers the agent follows the skill
# and bash answers "command not found".
#
# Headless only. V1 ran the browser on an X display and showed it in a VNC
# panel; V2 has no X server, no VNC panel, and no screenshot tool, so the
# skill directs the agent to `agent-browser screenshot <path>` instead. Do
# not add `--headed` support without also adding Xvfb and a viewer.
#
# Chromium comes from apt and is what Playwright (bundled inside
# agent-browser since 0.30) launches, through AGENT_BROWSER_EXECUTABLE_PATH.
# Playwright's own `chromium-headless-shell` was measured as an alternative:
# it needs the same X/GTK shared libraries, so it saves under 40 MB and adds
# a second browser-version axis to keep aligned.
#
# SIZE: these two layers add ~794 MB (chromium ~699 MB, agent-browser
# ~94 MB) to a ~386 MB base. That is the price of the capability — the
# browser binary is most of it and there is no smaller one that runs
# Playwright.
ARG AGENT_BROWSER_VERSION=0.34.0
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "agent-browser@${AGENT_BROWSER_VERSION}" \
    && npm cache clean --force
ENV AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

# Bundled auth gateway (Task 2): `node /gateway/dist/bin.js` is what
# docker/start-full.sh execs. Requires VALET_SESSION_ID +
# VALET_SANDBOX_JWT_SECRET in the pod/container env — exits 1 if missing.
COPY --from=gateway-build /out/gateway /gateway

# Rootless docker-in-sandbox toolchain (sandbox-docker design,
# docs/specs/2026-08-15-sandbox-docker-design.md). Baked always, dormant
# unless VALET_SANDBOX_DOCKER=1 — start scripts launch dockerd-rootless as
# the non-root `dockerd` user. Pinned; bump deliberately.
ARG DOCKER_VERSION=5:29.7.2-1~debian.12~bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      gnupg uidmap fuse-overlayfs slirp4netns iproute2 iptables \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && echo "deb [signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        docker-ce-cli=${DOCKER_VERSION} \
        docker-ce=${DOCKER_VERSION} \
        docker-ce-rootless-extras=${DOCKER_VERSION} \
        docker-buildx-plugin \
    && rm -rf /var/lib/apt/lists/*

# Exec-identity contract: `dockerd` gets its own primary group plus ONE
# supplementary group: `docker` (already created by the docker-ce
# package — do NOT groupadd it). Both providers depend on the group set —
# `docker exec -u dockerd` and the k8s setpriv wrapper (`--init-groups`)
# must resolve the same groups; if you add another one here, both pick it
# up. The docker group is what lets non-privileged workload execs reach
# the rootful-in-userns daemon's socket (start-docker.sh
# VALET_DOCKER_USERNS=1 branch: root:docker, mode 660).
# The sub-id range MUST fit inside a kubernetes pod user namespace
# (hostUsers: false maps exactly 65536 ids, 0..65535 — kubelet default).
# A range starting at 200000 has no mapping there, so newuidmap fails and
# rootless dockerd cannot start. 2000..65535 stays clear of the dockerd
# uid (1500) and the system ids; the cost is that container images with
# file uids >= 63536 lose those mappings (rare). (The rootless path only
# matters on the docker local-dev backend now — the k8s branch runs
# rootful inside the pod userns and never touches sub-ids.)
RUN (getent group docker >/dev/null || groupadd docker) \
    && useradd -m -u 1500 -G docker dockerd \
    && grep -v '^dockerd:' /etc/subuid > /tmp/subuid.tmp && mv /tmp/subuid.tmp /etc/subuid \
    && grep -v '^dockerd:' /etc/subgid > /tmp/subgid.tmp && mv /tmp/subgid.tmp /etc/subgid \
    && echo "dockerd:2000:63536" >> /etc/subuid \
    && echo "dockerd:2000:63536" >> /etc/subgid

COPY docker/start-docker.sh /start-docker.sh
COPY docker/start-headless.sh /start-headless.sh
RUN chmod +x /start-docker.sh /start-headless.sh

COPY docker/start-full.sh /start-full.sh
RUN chmod +x /start-full.sh

# Ports (full profile only — headless exposes none of these):
#   7681  ttyd (bound to 127.0.0.1, reached only via the gateway proxy)
#   8765  code-server (bound to 127.0.0.1, reached only via the gateway proxy)
#   9000  Auth gateway proxy
EXPOSE 7681 8765 9000

# No CMD/ENTRYPOINT override for headless — the k8s provider's PodSpec sets
# `command` explicitly per profile (tail for headless, start-full.sh for
# full), and the sandbox-docker provider does the same. A bare shell is a
# reasonable fallback for `docker run`-based smoke tests of this image on
# its own.
CMD ["/bin/bash"]
