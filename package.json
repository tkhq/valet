{
  "name": "valet",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @valet/worker dev",
    "build": "pnpm --filter @valet/worker build",
    "deploy": "pnpm --filter @valet/worker deploy",
    "db:migrate": "pnpm --filter @valet/worker db:migrate",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  }
}
