# Deployment Configuration
# Copy to .env.deploy.<env> (e.g. dev, prod, test, or a personal env). Keep the
# env name DNS-safe (lowercase letters, digits, hyphens): it feeds Modal endpoint
# labels and subdomains unsanitized.
# Usage: ENVIRONMENT=<env> make deploy
#
# All resource names derive from PROJECT_NAME to avoid collisions:
#   Worker:  ${PROJECT_NAME}           (e.g. valet-prod)
#   Pages:   ${PROJECT_NAME}-client    (e.g. valet-prod-client)
#   D1:      ${PROJECT_NAME}-db        (e.g. valet-prod-db)
#   R2:      ${PROJECT_NAME}-storage   (e.g. valet-prod-storage)
#   Modal:   ${PROJECT_NAME}-backend   (e.g. valet-prod-backend)

PROJECT_NAME=valet-yourname

# Required: public Worker origin. deploy.sh exits without it (no auto-discovery).
# Find your account subdomain with: wrangler whoami
# API_PUBLIC_URL=https://valet-yourname.<account-subdomain>.workers.dev

# Optional: comma-separated email allowlist (empty = no restriction)
ALLOWED_EMAILS=

# Modal — set both when deploying to a team workspace. The workspace slug is in
# your modal.com dashboard URL; `modal profile current` returns the profile
# name, which may differ, so auto-discovery can build the wrong endpoint URL.
# MODAL_WORKSPACE=          # workspace slug for endpoint URLs (https://<workspace>--<prefix>{label}.modal.run)
# MODAL_PROFILE=            # modal CLI profile to deploy with (see: modal profile list)

# Optional overrides (auto-discovered if omitted):
# D1_DATABASE_ID=           # looked up from wrangler d1 list
# MODAL_BACKEND_URL=        # full URL template; must keep the literal {label} placeholder (replaced per endpoint). Overrides MODAL_WORKSPACE-based construction.
# MODAL_APP_NAME=           # default: ${PROJECT_NAME}-backend
# MODAL_LABEL_PREFIX=       # default: ${ENVIRONMENT}- (prefixes Modal endpoint subdomains)
# MODAL_DEPLOY_CMD=         # default: uv run --project backend modal deploy
# CLIENT_BUILD_MODE=        # production | development; default: production only when ENVIRONMENT=prod
