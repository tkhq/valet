# Credentials for `make e2e` (docs/specs/2026-07-25-e2e-runner-design.md).
# Copy to .env.e2e (gitignored). Ambient/exported env vars always win over
# this file. Every tier is optional — steps whose tier is unset show as
# skipped in the scorecard with the exact vars to set.

# ── Tier: agent (arms orchestrator-smoke, session-smoke, integration-agent,
#            cli real-turn tests, fullstack-*) ─────────────────────────────
ANTHROPIC_API_KEY=

# ── Tier: optional providers (arms openai, onepassword) ────────────────────
OPENAI_API_KEY=
OP_SERVICE_ACCOUNT_TOKEN=
# Optional: an `op://vault/item/field` in the service-account vault. The
# live row uses it to exercise resolveReference. The test asserts length
# only and never prints the secret.
# OP_TEST_REFERENCE=
# Optional: a service id (e.g. `linear`) with a matching item title in the
# service-account vault. The agent-pull row resolves it through a session's
# own credential provider and asserts length only.
# OP_AGENT_PULL_SERVICE=

# ── Tier: telegram (arms telegram — live outbound delivery) ────────────────
TELEGRAM_TEST_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=

# ── Tier: github-live (arms github-live — real GitHub App) ─────────────────
VALET_GITHUB_LIVE_TEST=
VALET_GITHUB_LIVE_APP_ID=
VALET_GITHUB_LIVE_APP_PRIVATE_KEY_PEM=

# ── Tier: k8s full stack (arms fullstack-k8s; also needs the
#            rancher-desktop kubectl context; cold image build is 15-20 min) ─
VALET_E2E_K8S=
